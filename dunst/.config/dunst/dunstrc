[global]
frame_color = "#b4befe"
separator_color = frame
corner_radius = 5
offset = (20, 50)
font = FiraCode 12
width = (300, 600)
height = (100, 600)
min_icon_size = 48
max_icon_size = 164
frame_width = 2
gap_size = 5
stack_duplicates = false
enable_recursive_icon_lookup = true
icon_theme = Papirus

[urgency_low]
background = "#1e1e2ed0"
foreground = "#cdd6f4"

[urgency_normal]
background = "#1e1e2ed0"
foreground = "#cdd6f4"

[urgency_critical]
background = "#1e1e2ed0"
foreground = "#cdd6f4"
frame_color = "#f38ba8"
